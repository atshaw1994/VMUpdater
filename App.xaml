<Application x:Class="VMUpdater.App"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:helpers="clr-namespace:VMUpdater.Helpers"
             xmlns:local="clr-namespace:VMUpdater"
             RequestedThemeVariant="System">

    <Application.Styles>
        <FluentTheme />

        <!-- AddGlyphStyle for Icon TextBlocks -->
        <Style Selector="TextBlock.AddGlyphStyle">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontFamily" Value="Segoe Fluent Icons"/>
            <Setter Property="FontSize" Value="16"/>
        </Style>

        <!-- Custom ProgressBar Styling -->
        <Style Selector="ProgressBar">
            <Setter Property="Height" Value="8"/>
            <Setter Property="Background" Value="{DynamicResource ControlSolidFillColorDefaultBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentFillColorDefaultBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <ControlTemplate TargetType="ProgressBar">
                    <Grid x:Name="TemplateRoot">
                        <!-- 1. Track Background -->
                        <Rectangle x:Name="PART_Track" 
                                   Fill="{TemplateBinding Background}" 
                                   RadiusX="2" 
                                   RadiusY="2"/>

                        <!-- 2. Deterministic Fill Container (Managed natively by Avalonia via PART_Indicator) -->
                        <Grid x:Name="PART_Indicator" 
                              HorizontalAlignment="Left" 
                              ClipToBounds="True">

                            <Rectangle x:Name="IndicatorFill" 
                                       Fill="{TemplateBinding Foreground}" 
                                       RadiusY="3" 
                                       RadiusX="3"/>

                            <!-- Sheen Overlay Path -->
                            <Path x:Name="IndicatorSheen">
                                <Path.Fill>
                                    <LinearGradientBrush StartPoint="0%,50%" EndPoint="100%,50%">
                                        <GradientStop Color="#00FFFFFF" Offset="0"/>
                                        <GradientStop Color="#50FFFFFF" Offset="0.5"/>
                                        <GradientStop Color="#00FFFFFF" Offset="1"/>
                                    </LinearGradientBrush>
                                </Path.Fill>
                                <Path.Data>
                                    M0,8 l8,-8 h50 l-8,8z
                                </Path.Data>
                                <Path.RenderTransform>
                                    <TranslateTransform x:Name="SheenTransform" X="-20" />
                                </Path.RenderTransform>
                            </Path>
                        </Grid>

                        <!-- 3. Indeterminate Track Layer -->
                        <Grid x:Name="IndeterminateRoot" 
                              ClipToBounds="True" 
                              IsVisible="False">
                            <Rectangle x:Name="IndeterminatePill"
                                       Fill="{TemplateBinding Foreground}"
                                       RadiusX="4"
                                       RadiusY="4"
                                       Width="30"
                                       HorizontalAlignment="Left">
                                <Rectangle.RenderTransform>
                                    <TranslateTransform x:Name="PillTransform" X="-30" />
                                </Rectangle.RenderTransform>
                            </Rectangle>
                        </Grid>
                    </Grid>
                </ControlTemplate>
            </Setter>
        </Style>

        <!-- Indeterminate Toggle State -->
        <Style Selector="ProgressBar:indeterminate /template/ Grid#PART_Indicator">
            <Setter Property="IsVisible" Value="False"/>
        </Style>
        <Style Selector="ProgressBar:indeterminate /template/ Grid#IndeterminateRoot">
            <Setter Property="IsVisible" Value="True"/>
        </Style>

        <!-- Dynamic ScrollViewer Margin Helper for ItemsControl -->
        <Style Selector="ItemsControl.WithScrollBarMargin">
            <Setter Property="Margin" Value="0,0,0,0"/>
        </Style>
        <!-- Avalonia uses ScrollViewer state pseudo-classes rather than ComputedScrollBarVisibility -->
        <Style Selector="ScrollViewer:vertical-scrollbar-visible ItemsControl.WithScrollBarMargin">
            <Setter Property="Margin" Value="0,0,15,0"/>
        </Style>

    </Application.Styles>

    <!-- Tray Icon Definitions -->
    <TrayIcon.Icons>
        <TrayIcons>
            <TrayIcon Icon="avares://VMUpdater/Resources/VMUpdater.ico"
                      ToolTipText="{Binding TrayToolTipText}"
                      Command="{Binding ShowMainWindowCommand}">
                <TrayIcon.Menu>
                    <NativeMenu>
                        <NativeMenuItem Header="Open" Command="{Binding ShowMainWindowCommand}" />
                        <NativeMenuItem Header="Open Log" Command="{Binding ShowLogCommand}" />
                        <NativeMenuItem Header="Update All" Command="{Binding UpdateAllCommand}" />
                        <NativeMenuItemSeparator />
                        <NativeMenuItem Header="Exit" Command="{Binding ExitCommand}" />
                    </NativeMenu>
                </TrayIcon.Menu>
            </TrayIcon>
        </TrayIcons>
    </TrayIcon.Icons>

</Application>