<Application x:Class="VMUpdater.App"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:viewmodels="using:VMUpdater.ViewModels"
             RequestedThemeVariant="Default">

    <Application.Styles>
        <FluentTheme  />

        <!-- AddGlyphStyle for Icon TextBlocks -->
        <Style Selector="TextBlock.AddGlyphStyle">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontFamily" Value="Segoe Fluent Icons"/>
            <Setter Property="FontSize" Value="16"/>
        </Style>

        <!-- Dynamic ScrollViewer Margin Helper for ItemsControl -->
        <Style Selector="ItemsControl.WithScrollBarMargin">
            <Setter Property="Margin" Value="0,0,0,0"/>
        </Style>

        <!-- Avalonia uses ScrollViewer state pseudo-classes rather than ComputedScrollBarVisibility -->
        <Style Selector="ScrollViewer:vertical-scrollbar-visible ItemsControl.WithScrollBarMargin">
            <Setter Property="Margin" Value="0,0,15,0"/>
        </Style>

    </Application.Styles>

    <!-- Tray Icon Definitions -->
    <TrayIcon.Icons>
        <TrayIcons>
            <TrayIcon Icon="avares://VMUpdater/Resources/VMUpdater.ico"
                      x:DataType="viewmodels:MainViewModel"
                      ToolTipText="{Binding TrayToolTipText}"
                      Command="{Binding ShowMainWindowCommand}">
                <TrayIcon.Menu>
                    <NativeMenu x:DataType="viewmodels:MainViewModel">
                        <NativeMenuItem Header="Open" Command="{Binding ShowMainWindowCommand}" />
                        <NativeMenuItem Header="Show Log" Command="{Binding ShowLogCommand}" />
                        <NativeMenuItem Header="Update All" Command="{Binding UpdateAllCommand}" />
                        <NativeMenuItemSeparator />
                        <NativeMenuItem Header="Add">
                            <NativeMenu x:DataType="viewmodels:MainViewModel">
                                <NativeMenuItem Header="Virtual Machine" Command="{Binding AddVirtualMachineCommand}" />
                                <NativeMenuItem Header="Hypervisor" Command="{Binding AddHypervisorCommand}" />
                                <NativeMenuItem Header="GuestOS Type" Command="{Binding AddGuestOSCommand}" />
                            </NativeMenu>
                        </NativeMenuItem>
                        <NativeMenuItemSeparator />
                        <!-- Disabled until preferences are implemented
                        <NativeMenuItem Header="Preferences" Command="{Binding ShowPreferencesCommand}" />
                        -->
                        <NativeMenuItem Header="Exit" Command="{Binding ExitCommand}" />
                    </NativeMenu>
                </TrayIcon.Menu>
            </TrayIcon>
        </TrayIcons>
    </TrayIcon.Icons>

    <!-- macOS Top Menu Bar Definitions -->
    <NativeMenu.Menu>
        <NativeMenu x:DataType="viewmodels:MainViewModel">
            <NativeMenuItem Header="VMUpdater">
                <NativeMenu x:DataType="viewmodels:MainViewModel">
                    <NativeMenuItem Header="Show Log" Command="{Binding ShowLogCommand}" />
                    <NativeMenuItem Header="Update All" Command="{Binding UpdateAllCommand}" />
                    <NativeMenuItemSeparator />
                    <!-- Disabled until preferences are implemented
                    <NativeMenuItem Header="Preferences" Command="{Binding ShowPreferencesCommand}" />
                    -->
                    <NativeMenuItem Header="Exit" Command="{Binding ExitCommand}" />
                </NativeMenu>
            </NativeMenuItem>
            <NativeMenuItem Header="Add">
                <NativeMenu x:DataType="viewmodels:MainViewModel">
                    <NativeMenuItem Header="Virtual Machine" Command="{Binding AddVirtualMachineCommand}" />
                    <NativeMenuItem Header="Hypervisor" Command="{Binding AddHypervisorCommand}" />
                    <NativeMenuItem Header="GuestOS Type" Command="{Binding AddGuestOSCommand}" />
                </NativeMenu>
            </NativeMenuItem>
        </NativeMenu>
    </NativeMenu.Menu>

</Application>