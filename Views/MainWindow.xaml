<Window x:Class="VMUpdater.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:helpers="clr-namespace:VMUpdater.Helpers"
        xmlns:viewmodels="clr-namespace:VMUpdater.ViewModels"
        xmlns:views="clr-namespace:VMUpdater.Views"
        xmlns:local="clr-namespace:VMUpdater"
        Closing="Window_Closing"
        d:Foreground="Black"
        ThemeMode="System"
        mc:Ignorable="d"
        Title="VMUpdater" Height="450" Width="800">
    <Window.Resources>
        <helpers:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <DataTemplate DataType="{x:Type viewmodels:VirtualMachineViewModel}">
            <views:VirtualMachineEntry />
        </DataTemplate>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Menu -->
        <Menu>
            <MenuItem Header="File" Width="64">
                <MenuItem Header="Add New" Width="256">
                    <MenuItem Header="Add New Machine" Width="256" Command="{Binding AddVirtualMachineCommand}"/>
                    <MenuItem Header="Add New Hypervisor" Width="256" Command="{Binding AddHypervisorCommand}"/>
                    <MenuItem Header="Add New Guest OS Type" Width="256" Command="{Binding AddGuestOSCommand}"/>
                </MenuItem>
                <MenuItem Header="Import" Width="256" Command="{Binding ImportCommand}"/>
                <MenuItem Header="Export" Width="256" Command="{Binding ExportCommand}"/>
                <Separator/>
                <MenuItem Header="Show Log" Width="256" Command="{Binding ShowLogCommand}"/>
                <Separator/>
                <MenuItem Header="About" Width="256" Command="{Binding AboutCommand}"/>
                <MenuItem Header="Exit" Width="256" Command="{Binding ExitCommand}"/>
            </MenuItem>
            <MenuItem Header="Edit" Width="64">
                <MenuItem Header="Cut" Width="256" Command="ApplicationCommands.Cut"/>
                <MenuItem Header="Copy" Width="256" Command="ApplicationCommands.Copy"/>
                <MenuItem Header="Paste" Width="256" Command="ApplicationCommands.Paste"/>
                <Separator/>
                <MenuItem Header="Find" Width="256" Command="{Binding ToggleFindRowCommand}"/>
            </MenuItem>
        </Menu>

        <!-- Find Row -->
        <Grid Grid.Row="1" Height="0" ClipToBounds="True" d:Height="40">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsFindRowVisible}" Value="True">
                            <DataTrigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="Height"
                                                         To="40.0" 
                                                         Duration="0:0:0.25">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="Height"
                                                         To="0.0" 
                                                         Duration="0:0:0.2">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseIn" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBox x:Name="FindTextBox" Margin="8,0" Height="30"/>
            <Button Grid.Column="1" Content="&#xe721;" FontFamily="Segoe Fluent Icons" Margin="4,0" Padding="10,3" 
                    Command="ApplicationCommands.Find" CommandParameter="{Binding Text, ElementName=FindTextBox}"/>
            <Button Grid.Column="2" Content="&#xe711;" FontFamily="Segoe Fluent Icons" Margin="4,0" Padding="10,3" Command="{Binding ToggleFindRowCommand}"/>
        </Grid>

        <!-- Virtual Machines -->
        <Border Grid.Row="2" Background="{DynamicResource SmokeFillColorDefaultBrush}">
            <!-- Scrollable container for virtual machines + action button -->
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl Margin="10" ItemsSource="{Binding VirtualMachines}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <!-- Log Text -->
        <Border Grid.Row="2" 
                Background="Black"
                d:Visibility="Collapsed"
                Visibility="{Binding IsLogVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                
                <Button Height="30" 
                        HorizontalAlignment="Stretch" 
                        HorizontalContentAlignment="Right"
                        Command="{Binding ToggleLogCommand}">
                    <TextBlock Text="&#xE70D;"
                               FontFamily="Segoe Fluent Icons" 
                               d:Foreground="Black"
                               Foreground="{DynamicResource ControlStrongStrokeColorDefaultBrush}" 
                               HorizontalAlignment="Right" 
                               VerticalAlignment="Center"/>
                </Button>

                <TextBlock Text="Log" 
                           IsHitTestVisible="False" 
                           FontSize="16" 
                           VerticalAlignment="Center" 
                           Margin="8,0"/>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <TextBox Text="{Binding LogText}" VerticalScrollBarVisibility="Auto" Loaded="LogTextBox_Loaded" TextChanged="LogTextBox_TextChanged"/>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- Status Bar -->
        <StatusBar Grid.Row="3" HorizontalContentAlignment="Stretch">
            <StatusBar.ItemsPanel>
                <ItemsPanelTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                    </Grid>
                </ItemsPanelTemplate>
            </StatusBar.ItemsPanel>

            <!-- Left side: Status Message (Column 0 by default) -->
            <StatusBarItem HorizontalAlignment="Left" VerticalAlignment="Center" Margin="4,0,0,0">
                <TextBlock Text="{Binding StatusMessage}" d:Text="Ready." />
            </StatusBarItem>

            <!-- Right side: Update All / Progress Bar toggle (Column 1) -->
            <StatusBarItem Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,4,0">
                <Grid>
                    <!-- Show "Update All" when IsUpdating is false -->
                    <Button Command="{Binding UpdateAllCommand}"
                            Padding="10,3"
                            Margin="2"
                            Visibility="{Binding IsUpdating, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Inverse}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE896;" Margin="0,0,4,0" FontFamily="Segoe Fluent Icons" VerticalAlignment="Center"/>
                            <TextBlock Text="Update All" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- Show Progress Bar when IsUpdating is true -->
                    <StackPanel Orientation="Horizontal" 
                                VerticalAlignment="Center"
                                Visibility="{Binding IsUpdating, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <ProgressBar Value="{Binding UpdateProgress}" Width="150"/>
                        <TextBlock x:Name="ProgressBarPercentTextBlock" 
                                   Text="{Binding UpdateProgress, StringFormat={}{0:0}%}" 
                                   Margin="8,0,4,0" 
                                   VerticalAlignment="Center"
                                   d:Text="50%" />
                    </StackPanel>
                </Grid>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
