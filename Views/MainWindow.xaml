<Window x:Class="VMUpdater.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:helpers="clr-namespace:VMUpdater.Helpers"
        xmlns:viewmodels="clr-namespace:VMUpdater.ViewModels"
        xmlns:views="clr-namespace:VMUpdater.Views"
        xmlns:local="clr-namespace:VMUpdater"
        Closing="Window_Closing"
        d:Foreground="Black"
        ThemeMode="System"
        mc:Ignorable="d"
        Title="VMUpdater" Height="450" Width="800">
    <Window.Resources>
        <helpers:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <DataTemplate DataType="{x:Type viewmodels:VirtualMachineViewModel}">
            <views:VirtualMachineEntry />
        </DataTemplate>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Button Content="&#xe713;" FontFamily="Segoe Fluent Icons" HorizontalAlignment="Right" Margin="0,0,10,0" Command="{Binding SettingsCommand}"/>

        <!-- Scrollable container for virtual machines + action button -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" Grid.Row="1">
            <StackPanel Margin="10">
                <ItemsControl ItemsSource="{Binding VirtualMachines}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>

                <!-- Always renders directly beneath the last VM in the StackPanel -->
                <Button Content="Add Machine" 
                        Command="{Binding AddVirtualMachineCommand}" 
                        Margin="0,10,0,0" 
                        Padding="8"
                        HorizontalAlignment="Stretch"/>
            </StackPanel>
        </ScrollViewer>

        <!-- Status Bar -->
        <StatusBar Grid.Row="2" HorizontalContentAlignment="Stretch">
            <StatusBar.ItemsPanel>
                <ItemsPanelTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                    </Grid>
                </ItemsPanelTemplate>
            </StatusBar.ItemsPanel>

            <!-- Left side: Status Message (Column 0 by default) -->
            <StatusBarItem HorizontalAlignment="Left" VerticalAlignment="Center" Margin="4,0,0,0">
                <TextBlock Text="{Binding StatusMessage}" d:Text="Ready." />
            </StatusBarItem>

            <!-- Right side: Update All / Progress Bar toggle (Column 1) -->
            <StatusBarItem Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,4,0">
                <Grid>
                    <!-- Show "Update All" when IsUpdating is false -->
                    <Button Command="{Binding UpdateAllCommand}"
                            Padding="10,3"
                            Margin="2"
                            Visibility="{Binding IsUpdating, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Inverse}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE896;" Margin="0,0,4,0" FontFamily="Segoe Fluent Icons" VerticalAlignment="Center"/>
                            <TextBlock Text="Update All" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- Show Progress Bar when IsUpdating is true -->
                    <StackPanel Orientation="Horizontal" 
                                VerticalAlignment="Center"
                                Visibility="{Binding IsUpdating, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <ProgressBar Value="{Binding UpdateProgress}" Width="150"/>
                        <TextBlock x:Name="ProgressBarPercentTextBlock" 
                                   Text="{Binding UpdateProgress, StringFormat={}{0:0}%}" 
                                   Margin="8,0,4,0" 
                                   VerticalAlignment="Center"
                                   d:Text="50%" />
                    </StackPanel>
                </Grid>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
