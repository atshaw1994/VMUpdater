<Window x:Class="VMUpdater.Views.MainWindow"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:viewmodels="using:VMUpdater.ViewModels"
        xmlns:views="using:VMUpdater.Views"
        xmlns:ic="using:FluentIcons.Avalonia"
        x:DataType="viewmodels:MainViewModel"
        x:Name="RootWindow"
        Closing="Window_Closing"
        TransparencyLevelHint="Mica, AcrylicBlur"
        Background="{DynamicResource WindowBackgroundBrush}"
        RequestedThemeVariant="Default"
        Title="VMUpdater" Height="450" Width="800"
        MinWidth="650" MinHeight="400">
    <Window.DataTemplates>
        <DataTemplate DataType="viewmodels:VirtualMachineViewModel">
            <views:VirtualMachineEntry />
        </DataTemplate>
    </Window.DataTemplates>

    <Design.DataContext>
        <StaticResource ResourceKey="DesignMainViewModel" />
    </Design.DataContext>

    <Grid RowDefinitions="40,Auto,*,Auto">

        <!-- Toolbar -->
        <Grid Margin="8,8,8,0" ColumnDefinitions="*,Auto,Auto">
            <!-- Search -->
            <Grid Margin="0,0,8,0" VerticalAlignment="Center" ClipToBounds="True">
                <!-- Collapsed Search Button -->
                <Button Command="{Binding ExpandSearchBarCommand}" 
                        Height="32"
                        Cursor="Hand"
                        IsVisible="{Binding !IsSearchBarExpanded}">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <ic:FluentIcon Icon="Search" IconVariant="Regular" IconSize="Size12" />
                        <TextBlock Text="Search..." VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button.Transitions>
                        <Transitions>
                            <DoubleTransition Property="Opacity" Duration="0:0:0.15"/>
                        </Transitions>
                    </Button.Transitions>
                    <Button.Styles>
                        <Style Selector="Button">
                            <Setter Property="Opacity" Value="0.4" />
                        </Style>
                        <Style Selector="Button:pointerover">
                            <Setter Property="Opacity" Value="1.0" />
                        </Style>
                    </Button.Styles>
                </Button>

                <!-- Expanded Full-Width Search TextBox (Sliding via RenderTransform) -->
                <TextBox x:Name="FindTextBox"
                         Height="32"
                         HorizontalAlignment="Stretch"
                         RenderTransformOrigin="100%,50%"
                         Text="{Binding SearchText, Mode=TwoWay}"
                         PlaceholderText="Search..."
                         IsVisible="{Binding IsSearchBarExpanded}">
    
                    <TextBox.RenderTransform>
                        <ScaleTransform ScaleX="1" ScaleY="1" />
                    </TextBox.RenderTransform>

                    <TextBox.Transitions>
                        <Transitions>
                            <!-- Smooth Transform Transition -->
                            <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.8" Easing="CubicEaseOut"/>
                            <DoubleTransition Property="Opacity" Duration="0:0:0.1"/>
                        </Transitions>
                    </TextBox.Transitions>

                    <TextBox.Styles>
                        <!-- Visible: Full Scale -->
                        <Style Selector="TextBox[IsVisible=True]">
                            <Setter Property="RenderTransform" Value="scaleX(1)" />
                            <Setter Property="Opacity" Value="1.0" />
                        </Style>
                        <!-- Hidden: Scaled to 0 from Right Origin -->
                        <Style Selector="TextBox[IsVisible=False]">
                            <Setter Property="RenderTransform" Value="scaleX(0)" />
                            <Setter Property="Opacity" Value="0.0" />
                        </Style>
                    </TextBox.Styles>

                    <TextBox.InnerRightContent>
                        <Button Command="{Binding RetractSearchBarCommand}"
                                Width="22" Height="22"
                                Margin="0,0,4,0"
                                Padding="0"
                                Background="Transparent"
                                BorderThickness="0"
                                VerticalAlignment="Center"
                                HorizontalContentAlignment="Center"
                                VerticalContentAlignment="Center"
                                Cursor="Hand">
                            <Button.Styles>
                                <Style Selector="Button:pointerover /template/ ContentPresenter">
                                    <Setter Property="Background" Value="#20000000" />
                                    <Setter Property="CornerRadius" Value="4" />
                                </Style>
                                <Style Selector="Button:pressed /template/ ContentPresenter">
                                    <Setter Property="Background" Value="#40000000" />
                                </Style>
                            </Button.Styles>
                            <ic:FluentIcon Icon="Dismiss" IconVariant="Regular" IconSize="Size12"/>
                        </Button>
                    </TextBox.InnerRightContent>
                </TextBox>
            </Grid>

            <!-- Auto Mode Toggle -->
            <ToggleSwitch 
                Grid.Column="1" 
                Margin="0,-8.7,0,0"
                IsChecked="{Binding IsAutoMode}" 
                OnContent="" 
                OffContent=""/>

            <!-- Hamburger Menu -->
            <Button Grid.Column="2" Width="32">
                <Button.Styles>
                    <Style Selector="Button">
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="BorderBrush" Value="Transparent" />
                    </Style>
                </Button.Styles>
                <Button.Flyout>
                    <MenuFlyout Placement="BottomEdgeAlignedRight">
                        <MenuItem Header="Add">
                            <MenuItem Header="Virtual Machine" Command="{Binding AddVirtualMachineCommand}" />
                            <MenuItem Header="Hypervisor" Command="{Binding AddHypervisorCommand}" />
                            <MenuItem Header="Guest OS Type" Command="{Binding AddGuestOSCommand}" />
                        </MenuItem>
                        <MenuItem Header="Import" Command="{Binding ImportCommand}" />
                        <MenuItem Header="Export" Command="{Binding ExportCommand}" />
                        <Separator />
                        <MenuItem Header="Show Log" Command="{Binding ShowLogCommand}" />
                        <!-- Disabled until preferences are implemented 
                        <Separator/>
                        <MenuItem Header="Preferences" Command="{Binding ShowPreferencesCommand}" />
                        -->
                        <Separator />
                        <MenuItem Header="About" Command="{Binding AboutCommand}" />
                        <MenuItem Header="Exit" Command="{Binding ExitCommand}" />
                    </MenuFlyout>
                </Button.Flyout>
                <ic:FluentIcon Icon="MoreVertical" IconVariant="Regular" IconSize="Size16" />
            </Button>
        </Grid>

        <!-- Virtual Machines List -->
        <Border Grid.Row="2" 
                Margin="0,8,0,0" 
                Background="{DynamicResource SystemControlPageBackgroundMediumAltMediumBrush}">
            <ListBox ItemsSource="{Binding FilteredVirtualMachines}"
                     Margin="10,10,4,10"
                     Background="Transparent"
                     BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Auto">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.Styles>
                    <Style Selector="ListBoxItem">
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0,0,16,8" />
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="Template">
                            <ControlTemplate>
                                <ContentPresenter Content="{TemplateBinding Content}"
                                                  ContentTemplate="{TemplateBinding ContentTemplate}"/>
                            </ControlTemplate>
                        </Setter>
                    </Style>
                </ListBox.Styles>
            </ListBox>
        </Border>

        <!-- Log Text -->
        <Border Grid.RowSpan="3" 
                Background="{DynamicResource SystemControlPageBackgroundChromeLowBrush}"
                IsVisible="{Binding IsLogVisible}">
            <Grid RowDefinitions="Auto,*">
                <Button Height="32" Width="32" Margin="4,0" 
                        HorizontalAlignment="Right" HorizontalContentAlignment="Right"
                        Command="{Binding ToggleLogCommand}">
                    <ic:FluentIcon Icon="Dismiss" IconVariant="Regular" IconSize="Size12" />
                </Button>

                <TextBlock Text="Log" 
                           IsHitTestVisible="False" 
                           FontSize="16" 
                           VerticalAlignment="Center" 
                           Margin="8"/>

                <ScrollViewer Grid.Row="1" Margin="6,8" VerticalScrollBarVisibility="Auto">
                    <TextBox Text="{Binding LogText}" Loaded="LogTextBox_Loaded" TextChanged="LogTextBox_TextChanged"/>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- Preferences -->
        <Border Grid.RowSpan="3" 
                Background="{DynamicResource SystemControlPageBackgroundChromeLowBrush}"
                IsVisible="{Binding IsPreferencesVisible}">
            <Grid RowDefinitions="Auto,*">
                <Button Height="32" Width="32" Margin="4,0" 
                        HorizontalAlignment="Right" HorizontalContentAlignment="Right"
                        Command="{Binding TogglePreferencesCommand}">
                    <ic:FluentIcon Icon="Dismiss" IconVariant="Regular" IconSize="Size12" />
                </Button>

                <TextBlock Text="Preferences" 
                           IsHitTestVisible="False" 
                           FontSize="16" 
                           VerticalAlignment="Center" 
                           Margin="8"/>

                <Border Background="{DynamicResource SystemControlPageBackgroundChromeMediumLowBrush}"
                        Grid.Row="1"
                        Margin="8"
                        CornerRadius="6">
                    <ListBox VerticalAlignment="Top">
                    </ListBox>
                </Border>
            </Grid>
        </Border>

        <!-- Status Bar -->
        <Border Grid.Row="3" 
                Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}"
                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                BorderThickness="0,1,0,0"
                Padding="4,16">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0" 
                           Text="{Binding StatusMessage}" 
                           VerticalAlignment="Center" 
                           Margin="16,0,0,0"/>

                <Grid Grid.Column="1" Margin="0,0,4,0">
                    <Button Command="{Binding UpdateAllCommand}"
                            Padding="10,3"
                            Margin="2"
                            IsVisible="{Binding !IsUpdating}">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <TextBlock Text="Update All" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <StackPanel Orientation="Horizontal" 
                                VerticalAlignment="Center"
                                IsVisible="{Binding IsUpdating}">
                        <ProgressBar Value="{Binding UpdateProgress}" Width="150" Minimum="0" Maximum="100"/>
                        <TextBlock Text="{Binding UpdateProgress, StringFormat={}{0:0}%}" 
                                   Margin="8,0,4,0" 
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>