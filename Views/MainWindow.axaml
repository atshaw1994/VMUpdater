<Window x:Class="VMUpdater.Views.MainWindow"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewmodels="using:VMUpdater.ViewModels"
        xmlns:views="using:VMUpdater.Views"
        x:DataType="viewmodels:MainViewModel"
        x:Name="RootWindow"
        Closing="Window_Closing"
        RequestedThemeVariant="Default"
        Title="VMUpdater" Height="450" Width="800">
    <Window.DataTemplates>
        <DataTemplate DataType="viewmodels:VirtualMachineViewModel">
            <views:VirtualMachineEntry />
        </DataTemplate>
    </Window.DataTemplates>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Menu -->
        <Menu Grid.Row="0">
            <MenuItem Header="File" Width="64">
                <MenuItem Header="Add New" Width="256">
                    <MenuItem Header="Add New Machine" Width="256" Command="{Binding AddVirtualMachineCommand}"/>
                    <MenuItem Header="Add New Hypervisor" Width="256" Command="{Binding AddHypervisorCommand}"/>
                    <MenuItem Header="Add New Guest OS Type" Width="256" Command="{Binding AddGuestOSCommand}"/>
                </MenuItem>
                <MenuItem Header="Import" Width="256" Command="{Binding ImportCommand}"/>
                <MenuItem Header="Export" Width="256" Command="{Binding ExportCommand}"/>
                <MenuItem Header="Find" Width="256" Command="{Binding ToggleFindRowCommand}"/>
                <Separator/>
                <MenuItem Header="Show Log" Width="256" Command="{Binding ShowLogCommand}"/>
                <Separator/>
                <MenuItem Header="About" Width="256" Command="{Binding AboutCommand}"/>
                <MenuItem Header="Exit" Width="256" Command="{Binding ExitCommand}"/>
            </MenuItem>
        </Menu>

        <!-- Find Row -->
        <Grid Grid.Row="1" ClipToBounds="True" Height="0">
            <Grid.Transitions>
                <Transitions>
                    <DoubleTransition Property="Height" Duration="0:0:0.25" Easing="CubicEaseOut"/>
                </Transitions>
            </Grid.Transitions>
            <Grid.Styles>
                <Style Selector="Grid">
                    <Setter Property="Height" Value="0" />
                </Style>
                <Style Selector="Grid[IsVisible=True]">
                    <Setter Property="Height" Value="40" />
                </Style>
            </Grid.Styles>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBox x:Name="FindTextBox" Margin="8,0" Height="30" Text="{Binding SearchText}"/>
            <Button Grid.Column="1" Margin="4,0" Padding="10,3" Command="{Binding ToggleFindRowCommand}">
                <PathIcon Data="M 0 0 L 10 10 M 10 0 L 0 10" Width="10" Height="10" VerticalAlignment="Center"/>
            </Button>
        </Grid>

        <!-- Virtual Machines List -->
        <Border Grid.Row="2" Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}">
            <ListBox ItemsSource="{Binding FilteredVirtualMachines}"
                     Margin="10"
                     Background="Transparent"
                     BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Auto">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.Styles>
                    <Style Selector="ListBoxItem">
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0,0,0,8" />
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="Template">
                            <ControlTemplate>
                                <ContentPresenter Content="{TemplateBinding Content}"
                                                  ContentTemplate="{TemplateBinding ContentTemplate}"/>
                            </ControlTemplate>
                        </Setter>
                    </Style>
                </ListBox.Styles>
            </ListBox>
        </Border>

        <!-- Log Text -->
        <Border Grid.Row="2" 
                Background="Black"
                IsVisible="{Binding IsLogVisible}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Button Height="30" 
                        HorizontalAlignment="Stretch" 
                        HorizontalContentAlignment="Right"
                        Command="{Binding ToggleLogCommand}">
                    <PathIcon Data="M 0 0 L 5 5 L 10 0" 
                              Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" 
                              HorizontalAlignment="Right" 
                              VerticalAlignment="Center"/>
                </Button>

                <TextBlock Text="Log" 
                           IsHitTestVisible="False" 
                           FontSize="16" 
                           VerticalAlignment="Center" 
                           Margin="8,0"/>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <TextBox Text="{Binding LogText}"/>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- Status Bar -->
        <Border Grid.Row="3" 
                Background="{DynamicResource SystemControlBackgroundChromeLowBrush}"
                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                BorderThickness="0,1,0,0"
                Padding="4,2">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" 
                           Text="{Binding StatusMessage}" 
                           VerticalAlignment="Center" 
                           Margin="4,0,0,0"/>

                <Grid Grid.Column="1" Margin="0,0,4,0">
                    <Button Command="{Binding UpdateAllCommand}"
                            Padding="10,3"
                            Margin="2"
                            IsVisible="{Binding !IsUpdating}">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <PathIcon Data="M 12 2 A 10 10 0 1 0 22 12 A 10 10 0 0 0 12 2 Z" VerticalAlignment="Center"/>
                            <TextBlock Text="Update All" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <StackPanel Orientation="Horizontal" 
                                VerticalAlignment="Center"
                                IsVisible="{Binding IsUpdating}">
                        <ProgressBar Value="{Binding UpdateProgress}" Width="150" Minimum="0" Maximum="100"/>
                        <TextBlock Text="{Binding UpdateProgress, StringFormat={}{0:0}%}" 
                                   Margin="8,0,4,0" 
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>