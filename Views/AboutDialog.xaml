<Window x:Class="VMUpdater.Views.AboutDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:VMUpdater.Views"
        mc:Ignorable="d"
        ThemeMode="System"
        Title="About VMUpdater" 
        Height="450" Width="600"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource SmokeFillColorDefaultBrush}"
        Foreground="{DynamicResource TextFillColorPrimaryBrush}">

    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <Image Source="/VMUpdater.ico" Width="64" Height="64" HorizontalAlignment="Left" Margin="16,8,0,20"/>

        <!-- Header / App Info -->
        <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,0,0,20">
            <TextBlock Text="VMUpdater" 
                       FontSize="28" 
                       FontWeight="Bold" 
                       Foreground="#007ACC" 
                       HorizontalAlignment="Center"/>
            <TextBlock Text="Automated Headless VM Update Scheduler" 
                       FontSize="13" 
                       Foreground="#AAAAAA" 
                       Margin="0,4,0,0" 
                       HorizontalAlignment="Center"/>
            <TextBlock Text="Version 1.0" 
                       FontSize="11" 
                       Foreground="#888888" 
                       Margin="0,2,0,0" 
                       HorizontalAlignment="Center"/>
        </StackPanel>

        <!-- License & Description Box -->
        <Border Grid.Row="1" 
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" 
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" 
                BorderThickness="1" 
                CornerRadius="6" 
                Padding="15">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <TextBlock TextWrapping="Wrap" 
                           FontSize="12" 
                           LineHeight="18" 
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                    <Run Text="VMUpdater is designed to automate the process of starting, updating, and shutting down headless virtual machines on a scheduled basis."/>
                    <LineBreak/><LineBreak/>
                    <Run Text="Copyright © 2026 Aaron Shaw" FontWeight="SemiBold"/>
                    <LineBreak/><LineBreak/>
                    <Run Text="This program is free software: you can redistribute it and/or modify it under the terms of the GNU General Public License as published by the Free Software Foundation, either version 3 of the License, or (at your option) any later version."/>
                    <LineBreak/><LineBreak/>
                    <Run Text="This program is distributed in the hope that it will be useful, but WITHOUT ANY WARRANTY; without even the implied warranty of MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE. See the GNU General Public License for more details."/>
                </TextBlock>
            </ScrollViewer>
        </Border>

        <!-- Footer / Close Button -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="Close" 
                    Width="100" 
                    Height="32" 
                    IsDefault="True"
                    IsCancel="True"
                    Click="CloseButton_Click"
                    Background="#0E639C" 
                    Foreground="White" 
                    BorderThickness="0" 
                    Cursor="Hand">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="4"/>
                    </Style>
                </Button.Resources>
            </Button>
        </StackPanel>
    </Grid>
</Window>
