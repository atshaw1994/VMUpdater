<UserControl x:Class="VMUpdater.Views.HypervisorEntry"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:VMUpdater.Views"
             xmlns:vm="clr-namespace:VMUpdater.ViewModels"
             xmlns:helpers="clr-namespace:VMUpdater.Helpers"
             mc:Ignorable="d" d:DesignWidth="800">
    <UserControl.DataContext>
        <vm:HypervisorEntryViewModel />
    </UserControl.DataContext>
    <UserControl.Resources>
        <helpers:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </UserControl.Resources>
    <StackPanel>
        <StackPanel Margin="0,4" Orientation="Horizontal" 
                    Visibility="{Binding IsEditingName, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Inverse}">
            <TextBlock Text="{Binding HypervisorName}" FontSize="16" />
            <Button Content="&#xE70f;" FontFamily="Segoe MDL2 Assets" Margin="8,0" Command="{Binding EditNameCommand}" />
        </StackPanel>
        <!-- Edit Mode -->
        <Grid Margin="0,4" Visibility="{Binding IsEditingName, Converter={StaticResource BooleanToVisibilityConverter}}">
            <TextBox Text="{Binding TempName, UpdateSourceTrigger=PropertyChanged}" FontSize="16" />

            <Button Content="&#xE711;" 
                    FontFamily="Segoe MDL2 Assets" 
                    Margin="8,0" 
                    Grid.Column="1"
                    Command="{Binding CancelEditCommand}" />

            <Button Content="&#xE8fb;" 
                    FontFamily="Segoe MDL2 Assets" 
                    Margin="8,0" 
                    Grid.Column="2"
                    Command="{Binding SaveNameCommand}" />
        </Grid>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button Content="Browse..." Command="{Binding BrowseCommand}" Padding="12,6" FontWeight="SemiBold"/>
            <TextBox Text="{Binding HypervisorExecutablePath, UpdateSourceTrigger=PropertyChanged}" Margin="8,0" Grid.Column="1"/>
        </Grid>
    </StackPanel>
</UserControl>
