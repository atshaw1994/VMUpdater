<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net10.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<StartupObject>VMUpdater.Program</StartupObject>
		<ApplicationIcon>Resources\VMUpdater.ico</ApplicationIcon>
		<PackageLicenseExpression>GPL-3.0-only</PackageLicenseExpression>

		<CFBundleName>VMUpdater</CFBundleName>
		<CFBundleDisplayName>VMUpdater</CFBundleDisplayName>
		<CFBundleIdentifier>com.atshaw1994.vmupdater</CFBundleIdentifier>
		<CFBundleVersion>1.0.0</CFBundleVersion>
		<CFBundlePackageType>APPL</CFBundlePackageType>
		<CFBundleSignature>????</CFBundleSignature>
		<CFBundleExecutable>VMUpdater</CFBundleExecutable>
		<CFBundleIconFile>VMUpdater.icns</CFBundleIconFile>
		<CFBundleShortVersionString>1.0.0</CFBundleShortVersionString>
	</PropertyGroup>

	<ItemGroup>
		<AvaloniaResource Include="Resources\**\*.ico" />
		<AvaloniaResource Include="Resources\**\*.png" />
	</ItemGroup>

	<ItemGroup>
	  <None Remove="App.xaml" />
	</ItemGroup>

	<ItemGroup>
	  <AvaloniaXaml Include="App.xaml" />
	</ItemGroup>

	<ItemGroup>
		<Folder Include="Screenshots\" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="DotNet.Bundle" Version="0.9.13" />
		<PackageReference Include="FluentAvaloniaUI" Version="3.0.2" />
		<PackageReference Include="System.Resources.Extensions" Version="10.0.0" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Avalonia" Version="12.1.1" />
		<PackageReference Include="Avalonia.Desktop" Version="12.1.1" />
		<PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.1" />
		<PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.1" />
		<PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
		<PackageReference Include="FluentIcons.Avalonia" Version="2.1.333" />
		<PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.10" />
	</ItemGroup>

	<ItemGroup>
		<Compile Update="Properties\Resources.Designer.cs">
			<DesignTime>True</DesignTime>
			<AutoGen>True</AutoGen>
			<DependentUpon>Resources.resx</DependentUpon>
		</Compile>
	</ItemGroup>

	<ItemGroup>
		<EmbeddedResource Update="Properties\Resources.resx">
			<Generator>ResXFileCodeGenerator</Generator>
			<LastGenOutput>Resources.Designer.cs</LastGenOutput>
		</EmbeddedResource>
	</ItemGroup>

</Project>