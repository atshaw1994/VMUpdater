<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net10.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<StartupObject>VMUpdater.Program</StartupObject>
		<ApplicationIcon>Resources\VMUpdater.ico</ApplicationIcon>
		<PackageLicenseExpression>GPL-3.0-only</PackageLicenseExpression>
		<Version>1.0.0</Version>
	</PropertyGroup>

	<ItemGroup>
		<AvaloniaResource Include="Resources\**\*.ico" />
		<AvaloniaResource Include="Resources\**\*.png" />
	</ItemGroup>

	<ItemGroup>
		<None Remove="App.xaml" />
	</ItemGroup>

	<ItemGroup>
		<AvaloniaXaml Include="App.xaml" />
	</ItemGroup>

	<ItemGroup>
		<Folder Include="Screenshots\" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="FluentAvaloniaUI" Version="3.0.2" />
		<PackageReference Include="System.Resources.Extensions" Version="10.0.0" />
		<PackageReference Include="Avalonia" Version="12.1.1" />
		<PackageReference Include="Avalonia.Desktop" Version="12.1.1" />
		<PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.1" />
		<PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.1" />
		<PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
		<PackageReference Include="FluentIcons.Avalonia" Version="2.1.333" />
		<PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.10" />
	</ItemGroup>

	<ItemGroup>
		<Compile Update="Properties\Resources.Designer.cs">
			<DesignTime>True</DesignTime>
			<AutoGen>True</AutoGen>
			<DependentUpon>Resources.resx</DependentUpon>
		</Compile>
	</ItemGroup>

	<ItemGroup>
		<EmbeddedResource Update="Properties\Resources.resx">
			<Generator>ResXFileCodeGenerator</Generator>
			<LastGenOutput>Resources.Designer.cs</LastGenOutput>
		</EmbeddedResource>
	</ItemGroup>

	<!-- Build macOS .app Bundle Target -->
	<Target Name="BuildMacAppBundle" AfterTargets="Publish" Condition="'$(RuntimeIdentifier)' != '' And $(RuntimeIdentifier.StartsWith('osx'))">
		<PropertyGroup>
			<AppBundleDir>$(PublishDir)VMUpdater.app</AppBundleDir>
			<MacOSDir>$(AppBundleDir)/Contents/MacOS</MacOSDir>
			<ResourcesDir>$(AppBundleDir)/Contents/Resources</ResourcesDir>
		</PropertyGroup>

		<MakeDir Directories="$(MacOSDir)" />
		<MakeDir Directories="$(ResourcesDir)" />

		<Move SourceFiles="$(PublishDir)VMUpdater" DestinationFolder="$(MacOSDir)" Condition="Exists('$(PublishDir)VMUpdater')" />
		<Move SourceFiles="$(PublishDir)VMUpdater.pdb" DestinationFolder="$(MacOSDir)" Condition="Exists('$(PublishDir)VMUpdater.pdb')" />
		<Delete Files="$(PublishDir)VMUpdater.dll.config" Condition="Exists('$(PublishDir)VMUpdater.dll.config')" />

		<WriteLinesToFile File="$(AppBundleDir)/Contents/Info.plist" Overwrite="true" Lines="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?&gt;
&lt;!DOCTYPE plist PUBLIC &quot;-//Apple//DTD PLIST 1.0//EN&quot; &quot;http://www.apple.com/DTDs/PropertyList-1.0.dtd&quot;&gt;
&lt;plist version=&quot;1.0&quot;&gt;
&lt;dict&gt;
    &lt;key&gt;CFBundleExecutable&lt;/key&gt;
    &lt;string&gt;VMUpdater&lt;/string&gt;
    &lt;key&gt;CFBundleIdentifier&lt;/key&gt;
    &lt;string&gt;com.atshaw1994.vmupdater&lt;/string&gt;
    &lt;key&gt;CFBundleName&lt;/key&gt;
    &lt;string&gt;VMUpdater&lt;/string&gt;
    &lt;key&gt;CFBundlePackageType&lt;/key&gt;
    &lt;string&gt;APPL&lt;/string&gt;
    &lt;key&gt;CFBundleShortVersionString&lt;/key&gt;
    &lt;string&gt;1.0.0&lt;/string&gt;
    &lt;key&gt;CFBundleIconFile&lt;/key&gt;
    &lt;string&gt;VMUpdater.icns&lt;/string&gt;
&lt;/dict&gt;
&lt;/plist&gt;" />
	</Target>

</Project>